{
  "name": "coroot/symfony-demo",
  "description": "make-dev FrankenPHP + Symfony + Postgres traffic generator",
  "type": "project",
  "license": "Apache-2.0",
  "require": {
    "php": ">=8.3",
    "doctrine/dbal": "^4.2",
    "doctrine/doctrine-bundle": "^2.13",
    "runtime/frankenphp-symfony": "^0.2",
    "symfony/console": "^7.3",
    "symfony/framework-bundle": "^7.3",
    "symfony/runtime": "^7.3",
    "symfony/yaml": "^7.3"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true
    },
    "sort-packages": true
  },
  "extra": {
    "runtime": {
      "class": "Runtime\\FrankenPhpSymfony\\Runtime"
    }
  }
}
