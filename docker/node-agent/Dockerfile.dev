FROM golang:1.24-bookworm AS builder

RUN apt-get update \
  && apt-get install -y --no-install-recommends gcc libc6-dev libsystemd-dev pkg-config \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .

ENV CGO_ENABLED=1
# Same as upstream Dockerfile: go-nvml leaves NVML symbols undefined and dlopens
# libnvidia-ml at runtime. Without lazy binding, ld.so BIND_NOW aborts before main
# (undefined symbol: nvmlDeviceSetMemClkVfOffset) on nodes without a matching NVML.
RUN go build -mod=readonly -ldflags "-extldflags='-Wl,-z,lazy' -X github.com/coroot/coroot-node-agent/flags.Version=dev" -o /out/coroot-node-agent .

FROM debian:bookworm-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends libsystemd0 ca-certificates \
  && rm -rf /var/lib/apt/lists/*
COPY --from=builder /out/coroot-node-agent /usr/bin/coroot-node-agent
ENTRYPOINT ["coroot-node-agent"]
