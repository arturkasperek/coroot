FROM golang:1.25-bookworm

RUN apt-get update \
  && apt-get install -y --no-install-recommends liblz4-dev gcc libc6-dev \
  && rm -rf /var/lib/apt/lists/*

ENV GOFLAGS="-buildvcs=false"
ENV CGO_ENABLED=1

RUN go install github.com/air-verse/air@v1.65.3

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

# go:embed static requires at least one file at compile time. Tilt live_update
# plus an emptyDir for the Vue watcher replace this at runtime.
RUN mkdir -p static && echo placeholder > static/keep.txt

COPY docker/coroot/air.toml /app/docker/coroot/air.toml
COPY . /app

CMD ["air", "-c", "docker/coroot/air.toml"]
